# Copy to /etc/hypermesh/agent.env and chmod 0600.
# Do not commit a filled copy. The agent does not log these values.

HYPERMESH_CONTROL_PLANE_URL=http://127.0.0.1:8010
HYPERMESH_TENANT_ID=
HYPERMESH_ENROLL_TOKEN=
HYPERMESH_STATE_DIR=/var/lib/hypermesh

# Optional pin. Otherwise the agent hashes /etc/nv_tegra_release or /etc/os-release.
# HYPERMESH_IMAGE_HASH=

# Empty until the control plane documents a device-secret header. Do not set
# Authorization/Bearer on a guess.
# HYPERMESH_DEVICE_SECRET_HEADER=
# HYPERMESH_DEVICE_SECRET=
