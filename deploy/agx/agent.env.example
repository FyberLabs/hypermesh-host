# Copy to /etc/hypermesh/agent.env and chmod 0600.
# Do not commit a filled copy. These values are not written to the journal.

# Deployed test Panopticon. Path prefix is /api/v1/hypermesh.
# Not a localhost httptest. Unit tests use httptest.
HYPERMESH_CONTROL_PLANE_URL=https://api.test.hyperme.sh
HYPERMESH_TENANT_ID=
HYPERMESH_ENROLL_TOKEN=
HYPERMESH_STATE_DIR=/var/lib/hypermesh

# Host port published as docker -p <port>:8080 on lease_start.
# HYPERMESH_LISTEN_PORT=8080

# Local OpenAI-shaped probe for thin-v1 / instance_check.
# Default is http://127.0.0.1:8080/v1/chat/completions
# HYPERMESH_COMPLETIONS_URL=

# Required for lease_start. Regular file bind-mounted at /models/model.gguf:ro.
# Do not bake weights into the image. Missing path or a directory fails closed.
HYPERMESH_GGUF_PATH=/home/chris/hypermesh/workload/model.gguf

# Optional pin. Otherwise this box hashes /etc/nv_tegra_release or /etc/os-release.
# HYPERMESH_IMAGE_HASH=

# WireGuard backend. auto: kernel module when it is loaded or loadable,
# otherwise configure the interface owned by hypermesh-wg.service.
# AGX64-1 (L4T R39, no wireguard module) should set 1.
# Hosts with the kernel module should leave this unset or set 0.
# The agent never spawns wireguard-go. Do not set
# WG_QUICK_USERSPACE_IMPLEMENTATION; that forks wireguard-go inside
# hypermesh-agent.service, and a restart then kills the tunnel.
# HYPERMESH_WG_USERSPACE=1

# Prometheus text /metrics. Default is loopback only. Do not point this at
# the WireGuard address. A non-loopback bind is refused unless the opt-in
# is set, and then this box logs a warning.
# HYPERMESH_METRICS_ADDR=127.0.0.1:9464
# HYPERMESH_METRICS_ALLOW_NON_LOOPBACK=1

# After enroll, the secret lives in $HYPERMESH_STATE_DIR/device.json (0600).
# Do not put hm_dev_… here or on the systemd command line.
# HYPERMESH_DEVICE_SECRET= is a recovery override only.
