# Experimental Darwin dogfood. Not a certified host.
# Copy to /etc/hypermesh/agent.env and chmod 0600.
# Do not commit a filled copy. These values are not written to the journal.
#
# The agent reads this file on start. Launchd does not. A variable that
# is already set in the process environment is left as it is.
# Paths match the Linux agent: /etc/hypermesh and /var/lib/hypermesh.
# Creating them needs sudo. There is no second config directory.

# Deployed test control plane. Path prefix is /api/v1/hypermesh.
HYPERMESH_CONTROL_PLANE_URL=https://api.test.hyperme.sh

# Required. Tenant id is the marketplace UUID sent as X-Tenant-ID.
# The enroll token is one-time. After enroll, the device secret is
# stored in $HYPERMESH_STATE_DIR/device.json (0600). Do not put that
# secret in this file.
HYPERMESH_TENANT_ID=
HYPERMESH_ENROLL_TOKEN=

# Reported name. Empty uses the Mac's hostname.
HYPERMESH_HOST_NAME=

HYPERMESH_STATE_DIR=/var/lib/hypermesh
HYPERMESH_GGUF_PATH=/var/lib/hypermesh/models/model.gguf

# Mac has no WireGuard kernel module. 1 configures the utun interface
# owned by com.fyberlabs.hypermesh-wg. The agent does not spawn
# wireguard-go. Leave this set to 1.
HYPERMESH_WG_USERSPACE=1

# Empty uses utun8, the name in com.fyberlabs.hypermesh-wg.plist.
# If that utun is already taken, pick another free utunN, put it here,
# and use the same name as the last argument of wireguard-go in the plist.
# HYPERMESH_WG_IFACE=utun8

# Automatic updates stay off on Darwin. Do not set HYPERMESH_UPDATE_CHANNEL.
# A channel value does not install a new binary on this operating system.
