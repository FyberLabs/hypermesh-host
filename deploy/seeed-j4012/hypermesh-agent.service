[Unit]
Description=Hypermesh on this box
Documentation=https://github.com/FyberLabs/hypermesh-host
After=network-online.target docker.service hypermesh-wg.service
Wants=network-online.target

[Service]
Type=simple
User=root
# Default weights file. agent.env overrides this when HYPERMESH_GGUF_PATH
# is set. An empty or omitted variable uses the same path in the agent.
Environment=HYPERMESH_GGUF_PATH=/var/lib/hypermesh/models/model.gguf
EnvironmentFile=-/etc/hypermesh/agent.env
ExecStart=/usr/local/bin/hypermesh-agent
Restart=on-failure
RestartSec=5
# Super J4012 overlay. Same unit as deploy/agx.
# Default cgroup kill. Do not set KillMode=process or KillMode=mixed.
# Userspace wireguard-go, when used, belongs to hypermesh-wg.service.
KillMode=control-group
# Enroll token may be in agent.env (mode 0600) for first boot only.
# device_secret lives in $HYPERMESH_STATE_DIR/device.json (0600), not agent.env.
# Do not put secrets on the unit command line or in journal extra fields.

[Install]
WantedBy=multi-user.target
