# Super J4012 overlay. Same keys as deploy/agx.
# Copy to /etc/hypermesh/agent.env and chmod 0600.
# Do not commit a filled copy. These values are not written to the journal.

# Deployed test Panopticon. Path prefix is /api/v1/hypermesh.
# Not a localhost httptest. Unit tests use httptest.
# Do not invent a public network.
HYPERMESH_CONTROL_PLANE_URL=https://api.test.hyperme.sh
HYPERMESH_TENANT_ID=
HYPERMESH_ENROLL_TOKEN=
HYPERMESH_STATE_DIR=/var/lib/hypermesh

# Host port published as docker -p <port>:8080 on lease_start.
# HYPERMESH_LISTEN_PORT=8080

# Local OpenAI-shaped probe for thin-v1 / instance_check.
# Default is http://127.0.0.1:8080/v1/chat/completions
# HYPERMESH_COMPLETIONS_URL=

# Weights file bind-mounted at /models/model.gguf:ro.
# This is the default when the variable is omitted. An explicit path
# replaces it. The agent creates the models directory on start:
# root:root, mode 0755. The parent state directory is 0700 and weight
# files are 0600 root, so 0755 does not make the weights readable.
# Rootful Docker bind-mounts them as root.
# A missing file or a directory fails lease_start closed.
HYPERMESH_GGUF_PATH=/var/lib/hypermesh/models/model.gguf

# Free space that must remain after a model download, and extra bytes
# required beyond the object size. Defaults are 2 GiB and 64 MiB.
# HYPERMESH_DISK_FLOOR_BYTES=2147483648
# HYPERMESH_DISK_MARGIN_BYTES=67108864

# Optional pin. Otherwise this box hashes /etc/nv_tegra_release or /etc/os-release.
# Host-certification passed=true still needs a non-empty image_hash.
# HYPERMESH_IMAGE_HASH=

# Prometheus text /metrics. Empty follows the hypermesh interface address
# (for example 10.77.0.3:9464) and falls back to 127.0.0.1:9464 when the
# tunnel is down. An explicit value is accepted only for loopback or that
# WireGuard address. 0.0.0.0 and public addresses are refused.
# HYPERMESH_METRICS_ADDR=

# After enroll, the secret lives in $HYPERMESH_STATE_DIR/device.json (0600).
# Do not put hm_dev_… here or on the systemd command line.
# HYPERMESH_DEVICE_SECRET= is a recovery override only.
